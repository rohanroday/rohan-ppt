  "templates": [
    {
      "Name": "Temp1",
      "Slide_Title": "Introduction",
      "Slide_HTML": "<h1 style=\"color:#1f4e79;text-align:center\">#Account_Name$</h1>\n<p style=\"text-align:center\"><i>Property portfolio prepared by #Owner.name$</i></p>\n<ul>\n<li><b>Industry:</b> #Industry$</li>\n<li><b>City:</b> #Billing_City$</li>\n<li><b>Phone:</b> #Phone$</li>\n<li><b>Website:</b> #Website$</li>\n</ul>",
      "Module_Name": "Accounts",
      "Slide_Order": 1
    },
    {
      "Name": "Temp1",
      "Slide_Title": "Property Listings",
      "Slide_HTML": "<h2 style=\"color:#1f4e79\">Property Listings for #Account.Account_Name$</h2>\n<table border=\"1\" style=\"width:100%;border-collapse:collapse\">\n<tr style=\"background-color:#1f4e79;color:#ffffff\"><th>S.No</th><th>Property</th><th>Location</th><th>Type</th><th>Area (sq ft)</th><th>Price</th></tr>\n#RowCountIterator\n<tr><td>#Sno$</td><td>#Name$</td><td>#Location$</td><td>#Type$</td><td>#Area$</td><td>#Price$</td></tr>\n$RowCountIterator\n</table>",
      "Limit_of_Rows": 20,
      "Module_Name": "Property_Options",
      "Slide_Order": 2
    },
    {
      "Name": "Temp1",
      "Slide_Title": "Contact Details",
      "Slide_HTML": "<h2 style=\"color:#1f4e79\">Contact Details</h2>\n<p>Your contacts at #Account.Account_Name$:</p>\n<table border=\"1\" style=\"width:100%;border-collapse:collapse\">\n<tr style=\"background-color:#1f4e79;color:#ffffff\"><th>S.No</th><th>Name</th><th>Title</th><th>Email</th><th>Phone</th></tr>\n#RowCountIterator\n<tr><td>#Sno$</td><td>#Full_Name$</td><td>#Title$</td><td>#Email$</td><td>#Phone$</td></tr>\n$RowCountIterator\n</table>",
      "Module_Name": "Contacts",
      "Slide_Order": 3
    },
    {
      "Name": "Temp2",
      "Slide_Title": "Account Summary",
      "Slide_HTML": "<h1 style=\"color:#7a3e00\">#Account_Name$ at a glance</h1>\n<p>#Description$</p>\n<p><b>Owner:</b> #Owner.name$ &nbsp; <b>City:</b> #Billing_City$</p>",
      "Module_Name": "Accounts",
      "Slide_Order": 1
    },
    {
      "Name": "Temp2",
      "Slide_Title": "Shortlist",
      "Slide_HTML": "<h2 style=\"color:#7a3e00\">Shortlist</h2>\n<table border=\"1\" style=\"width:100%;border-collapse:collapse\">\n<tr style=\"background-color:#7a3e00;color:#ffffff\"><th>#</th><th>Property</th><th>Price</th></tr>\n#RowCountIterator\n<tr><td>#Sno$</td><td>#Name$</td><td>#Price$</td></tr>\n$RowCountIterator\n</table>",
      "Limit_of_Rows": 10,
      "Module_Name": "Property_Options",
      "Slide_Order": 2
    }
  ]
